{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlantUML Skill Attempt",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "skill_version_id",
    "case_id",
    "model_or_agent",
    "created_at",
    "raw_response_path"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "skill_version_id": { "type": "string" },
    "case_id": { "type": "string", "minLength": 1 },
    "model_or_agent": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "raw_response_path": { "type": "string", "minLength": 1 },
    "puml_text": { "type": "string" }
  }
}
